# Copy to keystore.properties (ignored by Git). Never commit real passwords.
# Keep the original release key and this completed file in a private backup.
# storeFile is relative to the project root.
storeFile=signing/tally-release.p12
storeType=PKCS12
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=tally-release
# PKCS12 uses the same key and store password with the current JDK tooling.
keyPassword=YOUR_KEYSTORE_PASSWORD

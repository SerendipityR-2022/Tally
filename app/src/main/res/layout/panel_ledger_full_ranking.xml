<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_ledger_entry">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="6dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="支出排行" android:textColor="@color/ledger_text" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
        <ImageButton android:id="@+id/ledger_full_rank_close" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_close" android:tint="@color/ledger_text" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="关闭排行" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/ledger_full_rank_list" android:layout_width="match_parent"
        android:layout_height="420dp" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>

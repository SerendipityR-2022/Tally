<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/marker_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:contentPadding="12dp">
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_marker_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1月15日"
            android:textColor="@color/black_marker"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />
        <TextView
            android:id="@+id/tv_marker_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收入: +0"
            android:textColor="@color/income_red"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/tv_marker_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支出: -0"
            android:textColor="@color/expense_green"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginVertical="4dp" />
        <TextView
            android:id="@+id/tv_marker_net"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="净收支: 0"
            android:textColor="@color/app_blue"
            android:textStyle="bold"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

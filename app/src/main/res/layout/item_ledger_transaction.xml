<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="66dp" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingVertical="8dp"
    android:foreground="?attr/selectableItemBackground">
    <ImageView android:id="@+id/ledger_tx_icon" android:layout_width="38dp" android:layout_height="38dp"
        android:padding="8dp" android:background="@drawable/bg_ledger_icon" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="11dp" android:layout_marginEnd="8dp" android:orientation="vertical">
        <TextView android:id="@+id/ledger_tx_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:fontFamily="sans-serif-medium"
            android:textSize="15sp" android:textColor="@color/ledger_text" />
        <TextView android:id="@+id/ledger_tx_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1"
            android:textSize="12sp" android:textColor="@color/ledger_muted" />
    </LinearLayout>
    <TextView android:id="@+id/ledger_tx_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="126dp" android:maxLines="1" android:ellipsize="end" android:gravity="end"
        android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:textSize="16sp"
        android:textColor="@color/ledger_text" />
    <ImageView android:id="@+id/ledger_tx_photo" android:layout_width="16dp" android:layout_height="16dp"
        android:layout_marginStart="6dp" android:src="@drawable/ic_image" android:tint="@color/ledger_muted"
        android:contentDescription="有照片" android:visibility="gone" />
</LinearLayout>

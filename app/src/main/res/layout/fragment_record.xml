<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ledger_canvas">
    <LinearLayout
        android:id="@+id/record_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">
        <LinearLayout
            android:id="@+id/layout_top_bar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tv_month_title"
                android:text="2025年12月"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:minHeight="48dp"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:contentDescription="选择年月"
                android:paddingEnd="8dp" />
            <TextView
                android:id="@+id/tv_month_label"
                android:text="12月"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:gravity="center_vertical"
                android:contentDescription="打开年度账单"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btn_prev_month"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="上一月"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_primary" />
        <ImageButton
            android:id="@+id/btn_next_month"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="下一月"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_primary" />
        <com.example.budgetapp.ui.PageSettingsButton
            android:id="@+id/btn_settings_menu"
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        android:layout_below="@id/record_header"
        android:layout_marginHorizontal="@dimen/record_calendar_margin"
        android:layout_marginBottom="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:baselineAligned="false">
            <LinearLayout
                android:id="@+id/layout_stat_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ripple_stat_item">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="收入"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tv_month_income"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/income_red"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_stat_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ripple_stat_item">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支出"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tv_month_expense"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/expense_green"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_stat_balance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ripple_stat_item">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="结余"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tv_month_balance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/app_blue"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/layout_stat_overtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/ripple_stat_item">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加班"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary" />
                <TextView
                    android:id="@+id/tv_month_overtime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:textColor="#FF9800"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <FrameLayout
        android:id="@+id/calendar_space"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/card_stats"
        android:layout_above="@id/btn_quick_record"
        android:layout_marginHorizontal="@dimen/record_calendar_margin"
        android:layout_marginBottom="12dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/calendar_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ledger_canvas"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/layout_week_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_ledger_panel"
                    android:minHeight="36dp"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="日"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="一"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="二"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="三"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="四"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="五"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="六"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ledger_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/calendar_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/card_budget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/btn_quick_record"
        android:layout_alignBottom="@id/btn_quick_record"
        android:layout_toStartOf="@id/btn_quick_record"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="今日预算"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView
                    android:id="@+id/tv_budget_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 / 0.00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
            <ProgressBar
                android:id="@+id/pb_budget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/layer_budget_progress" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <include layout="@layout/card_no_bill" android:id="@+id/layout_no_bill" />
    <androidx.cardview.widget.CardView
        android:id="@+id/card_bill_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/btn_quick_record"
        android:layout_alignBottom="@id/btn_quick_record"
        android:layout_toStartOf="@id/btn_quick_record"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        android:visibility="gone">
        <include
            layout="@layout/card_bill_slider"
            android:id="@+id/layout_bill_slider"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btn_quick_record"
        style="@style/Widget.Tally.QuickRecord"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:layout_alignParentBottom="true"
        android:contentDescription="@string/record_action"
        app:srcCompat="@drawable/ic_qs_record" />
</RelativeLayout>

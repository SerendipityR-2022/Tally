<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/app_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp"
        android:focusableInTouchMode="true">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="高级筛选"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="账单类型"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp" />
                <androidx.appcompat.widget.AppCompatSpinner
                    style="@style/Widget.Tally.FormSpinner"
                    android:id="@+id/sp_filter_type"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="金额区间"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        style="@style/Widget.Tally.FormInput"
                        android:id="@+id/et_min_amount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="最小"
                        android:inputType="numberDecimal" />
                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="8dp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        style="@style/Widget.Tally.FormInput"
                        android:id="@+id/et_max_amount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="最大"
                        android:inputType="numberDecimal" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时间范围"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:id="@+id/btn_start_date"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="起始日期"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="@dimen/tally_form_text_inset"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary"
                        android:clickable="true"
                        android:focusable="true" />
                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_gravity="center"
                        android:layout_marginHorizontal="8dp" />
                    <TextView
                        android:id="@+id/btn_end_date"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="结束日期"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="@dimen/tally_form_text_inset"
                        android:textSize="16sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorSecondary"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分类关键字"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp" />
                <com.example.budgetapp.ui.CustomHighlightEditText
                    style="@style/Widget.Tally.FormInput"
                    android:id="@+id/et_category"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="输入分类名称"
                    android:layout_marginBottom="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="资产筛选"
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginBottom="8dp" />
                <com.example.budgetapp.ui.CustomHighlightEditText
                    style="@style/Widget.Tally.FormInput"
                    android:id="@+id/et_asset"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="输入资产名称" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button.Secondary"
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="重置"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button"
                android:id="@+id/btn_apply"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="确认" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ai_setting_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/settings_toolbar"
        style="@style/TallySettingsToolbar">
        <com.example.budgetapp.ui.BackButton android:layout_width="48dp" android:layout_height="48dp" />
        <TextView
            style="@style/TallySettingsTitle"
            android:text="AI 记账" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="启用 AI 记账"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_ai_enable"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumb="@drawable/switch_thumb_custom"
                        app:thumbTint="@null"
                        app:track="@drawable/switch_track_custom"
                        app:trackTint="@null"
                        android:minHeight="48dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="连接"
                            android:textColor="@color/app_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/tv_ai_guide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="配置指南 ›"
                            android:textColor="@color/app_blue"
                            android:textSize="13sp"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="48dp"
                            android:gravity="center_vertical" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="接口地址（Base URL）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_base_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="https://api.openai.com 或 https://api.xxx.com/v1"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:minHeight="52dp"
                        android:layout_marginVertical="8dp"
                        android:textColor="@color/text_primary" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="API Key"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="sk-..."
                        android:inputType="textPassword"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:minHeight="52dp"
                        android:layout_marginVertical="8dp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="文本模型"
                            android:textColor="@color/app_blue"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/btn_switch_text_model"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="切换模型"
                            android:textColor="@color/app_blue"
                            android:textSize="13sp"
                            android:padding="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:minHeight="48dp"
                            android:gravity="center_vertical" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="模型名称"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_text_model"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="gpt-4o-mini / deepseek-chat / 其他文本模型"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:minHeight="52dp"
                        android:layout_marginVertical="8dp"
                        android:textColor="@color/text_primary" />
                    <include android:id="@+id/text_model_picker" layout="@layout/include_ai_model_picker" />
                    <TextView
                        android:id="@+id/tv_text_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="文本模型：未检测"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button.Text"
                android:id="@+id/btn_ai_advanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="更多选项"
                android:gravity="start|center_vertical"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="end" />
            <LinearLayout
                android:id="@+id/ai_advanced_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/assets_field">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="文本模型独立连接"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="独立接口地址（可选）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_text_base_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="留空则使用默认连接信息"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:minHeight="52dp"
                        android:layout_marginVertical="8dp"
                        android:textColor="@color/text_primary" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="独立 API Key（可选）"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_text_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input_field"
                        android:hint="留空则使用默认连接信息"
                        android:inputType="textPassword"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:paddingHorizontal="14dp"
                        android:minHeight="52dp"
                        android:layout_marginVertical="8dp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="图片模型"
                                android:textColor="@color/app_blue"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/btn_switch_vision_model"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="切换模型"
                                android:textColor="@color/app_blue"
                                android:textSize="13sp"
                                android:padding="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:minHeight="48dp"
                                android:gravity="center_vertical" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="模型名称"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_vision_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:hint="gpt-4o / 其他多模态模型"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:minHeight="52dp"
                            android:layout_marginVertical="8dp"
                            android:textColor="@color/text_primary" />
                        <include
                            android:id="@+id/vision_model_picker"
                            layout="@layout/include_ai_model_picker" />
                        <TextView
                            android:id="@+id/tv_vision_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="视觉模型：未配置"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="独立接口地址（可选）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_vision_base_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:hint="留空则使用文本模型配置"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:minHeight="52dp"
                            android:layout_marginVertical="8dp"
                            android:textColor="@color/text_primary" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="独立 API Key（可选）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_vision_api_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:hint="留空则使用文本模型配置"
                            android:inputType="textPassword"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:minHeight="52dp"
                            android:layout_marginVertical="8dp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="语音模型"
                                android:textColor="@color/app_blue"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/btn_switch_audio_model"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="切换模型"
                                android:textColor="@color/app_blue"
                                android:textSize="13sp"
                                android:padding="4dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:minHeight="48dp"
                                android:gravity="center_vertical" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="模型名称"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_audio_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:hint="gpt-4o-mini-transcribe / whisper-1 / 其他转写模型"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:minHeight="52dp"
                            android:layout_marginVertical="8dp"
                            android:textColor="@color/text_primary" />
                        <include
                            android:id="@+id/audio_model_picker"
                            layout="@layout/include_ai_model_picker" />
                        <TextView
                            android:id="@+id/tv_audio_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="音频模型：未配置"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="独立接口地址（可选）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_audio_base_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:hint="留空则使用文本模型配置"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:minHeight="52dp"
                            android:layout_marginVertical="8dp"
                            android:textColor="@color/text_primary" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="独立 API Key（可选）"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_audio_api_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_input_field"
                            android:hint="留空则使用文本模型配置"
                            android:inputType="textPassword"
                            android:paddingVertical="12dp"
                            android:textSize="14sp"
                            android:paddingHorizontal="14dp"
                            android:minHeight="52dp"
                            android:layout_marginVertical="8dp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="保存账单截图"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvScreenshotAutoSaveDesc"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="开启后，截图记账时自动将截图保存到账单照片备注"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/tvScreenshotAutoSaveHint"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="需要先开启照片备注"
                                android:textColor="#FF9800"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchScreenshotAutoSave"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/switch_thumb_custom"
                            app:thumbTint="@null"
                            app:track="@drawable/switch_track_custom"
                            app:trackTint="@null"
                            android:minHeight="48dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:padding="20dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="开启静默记账"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="开启后，AI识别到账单直接保存，不需要点击确认"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAiSilentRecording"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumb="@drawable/switch_thumb_custom"
                            app:thumbTint="@null"
                            app:track="@drawable/switch_track_custom"
                            app:trackTint="@null"
                            android:minHeight="48dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_ai_category_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="分类规则"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_ai_prompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="20dp"
                        android:gravity="center_vertical">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="识别规则"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/app_background"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Tally.Button.Secondary"
            android:id="@+id/btn_test_connection"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="测试连接"
            app:strokeColor="@color/button_stroke_yellow_selector"
            app:strokeWidth="2dp"
            app:rippleColor="@color/app_blue" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Tally.Button"
            android:id="@+id/btn_save_ai_config"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="保存" />
    </LinearLayout>
</LinearLayout>

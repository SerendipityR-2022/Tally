<?xml version='1.0' encoding='utf-8'?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:id="@+id/tv_transfer_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="资产转移"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />
        <Spinner
            style="@style/Widget.Tally.FormSpinner"
            android:id="@+id/spinner_from_account"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp" />
        <Spinner
            style="@style/Widget.Tally.FormSpinner"
            android:id="@+id/spinner_to_account"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp" />
        <com.example.budgetapp.ui.CustomHighlightEditText
            style="@style/Widget.Tally.FormInput"
            android:id="@+id/et_transfer_amount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:hint="转账金额"
            android:inputType="numberDecimal"
            android:textSize="16sp" />
        <com.example.budgetapp.ui.CustomHighlightEditText
            style="@style/Widget.Tally.FormInput"
            android:id="@+id/et_transfer_discount"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:hint="优惠金额"
            android:inputType="numberDecimal"
            android:textSize="16sp" />
        <com.example.budgetapp.ui.CustomHighlightEditText
            style="@style/Widget.Tally.FormInput"
            android:id="@+id/et_transfer_note"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:hint="备注 (选填)"
            android:inputType="text"
            android:textSize="16sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button.Secondary"
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="取消"
                android:layout_marginEnd="8dp" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button"
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="确认" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

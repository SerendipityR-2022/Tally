<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_marginVertical="@dimen/ledger_category_row_margin"
    android:minHeight="62dp" android:gravity="center" android:orientation="vertical" android:padding="4dp"
    android:focusable="true" android:background="@drawable/selector_category_icon_choice">
    <FrameLayout android:layout_width="45dp" android:layout_height="29dp">
        <ImageView android:id="@+id/ledger_category_icon" android:layout_width="28dp" android:layout_height="28dp"
            android:layout_gravity="center" android:padding="2dp" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/ledger_category_expand" android:layout_width="15dp" android:layout_height="15dp"
            android:layout_gravity="end|bottom" android:src="@drawable/ic_arrow_drop_down" android:tint="@color/ledger_muted"
            android:importantForAccessibility="no" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/tv_category_icon" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
        android:textSize="11sp" android:textColor="@color/ledger_text" />
</LinearLayout>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:background="@color/bar_background">
    <LinearLayout
        android:id="@+id/settings_toolbar"
        style="@style/TallySettingsToolbar">
        <com.example.budgetapp.ui.BackButton android:layout_width="48dp" android:layout_height="48dp" />
        <TextView
            style="@style/TallySettingsTitle"
            android:text="订阅提醒" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_renewal_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无自动续费提醒"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button"
                android:id="@+id/btn_add_renewal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="+ 添加续费提醒"
                android:elevation="0dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/record_calendar_min_row_height"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/calendar_day_surface"
        android:layout_width="@dimen/ledger_calendar_face_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="2dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingVertical="5dp">

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:minHeight="24dp"
            android:textColor="@color/ledger_text"
            android:textSize="19sp"
            tools:text="15" />

        <TextView
            android:id="@+id/tv_net_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minLines="1"
            android:paddingHorizontal="1dp"
            android:textColor="@color/ledger_muted"
            android:textSize="@dimen/record_calendar_caption_size"
            tools:text="初二" />

        <View
            android:id="@+id/calendar_day_underline"
            android:layout_width="22dp"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:importantForAccessibility="no"
            android:visibility="invisible" />
    </LinearLayout>
</FrameLayout>

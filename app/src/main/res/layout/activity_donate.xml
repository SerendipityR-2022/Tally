<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/donate_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bar_background">
    <LinearLayout
        android:id="@+id/settings_toolbar"
        style="@style/TallySettingsToolbar">
        <com.example.budgetapp.ui.BackButton android:layout_width="48dp" android:layout_height="48dp" />
        <TextView
            style="@style/TallySettingsTitle"
            android:text="捐赠支持" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="请作者喝杯咖啡"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="24dp"
                    android:textColor="?android:attr/textColorPrimary" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/iv_wechat_qr"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/wechat"
                            android:scaleType="fitCenter"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="微信支付"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <ImageView
                            android:id="@+id/iv_alipay_qr"
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:src="@drawable/pay"
                            android:scaleType="fitCenter"
                            android:background="?android:attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="支付宝"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击二维码保存到相册"
                    android:textSize="12sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Tally.Button.Text"
            android:id="@+id/btn_copy_github_donate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="https://github.com/cypressincloud/Tally"
            android:layout_gravity="center_horizontal"
            app:rippleColor="@android:color/transparent" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点击后复制到剪切板"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp" />
    </LinearLayout>
</LinearLayout>

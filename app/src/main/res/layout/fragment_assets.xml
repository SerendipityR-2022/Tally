<?xml version='1.0' encoding='utf-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bar_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/tv_top_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:text="资产"
                android:textSize="24sp"
                android:textColor="@color/text_primary"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium" />
            <com.example.budgetapp.ui.PageSettingsButton
                android:id="@+id/btn_page_settings"
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>
        <com.example.budgetapp.ui.LedgerSummaryCard android:id="@+id/card_assets_summary" style="@style/TallySummaryCard">
            <LinearLayout style="@style/TallySummaryContent">
                <LinearLayout style="@style/TallySummaryPrimary" android:id="@+id/layout_assets" android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                    <TextView android:id="@+id/tv_total_assets_label" style="@style/TallySummaryPrimaryLabel" android:text="总资产" />
                    <TextView android:id="@+id/tv_total_assets" style="@style/TallySummaryPrimaryValue" android:text="0.00" />
                </LinearLayout>
                <View android:id="@+id/ledger_summary_divider" style="@style/TallySummaryDivider" />
                <LinearLayout style="@style/TallySummaryMetrics">
                    <LinearLayout style="@style/TallySummaryMetric" android:id="@+id/layout_liability" android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView style="@style/TallySummaryMetricLabel" android:text="负债" />
                        <TextView android:id="@+id/tv_total_liability" style="@style/TallySummaryMetricValue" android:text="0.00" android:textColor="@color/expense_green" />
                    </LinearLayout>
                    <LinearLayout style="@style/TallySummaryMetric" android:id="@+id/layout_lent" android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <TextView style="@style/TallySummaryMetricLabel" android:text="借出" />
                        <TextView android:id="@+id/tv_total_lent" style="@style/TallySummaryMetricValue" android:text="0.00" android:textColor="@color/income_red" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.example.budgetapp.ui.LedgerSummaryCard>
        <TextView
            android:id="@+id/tv_list_title"
            style="@style/TallySummarySectionHeading"
            android:text="我的资产" />
        <HorizontalScrollView
            android:id="@+id/hsv_asset_category_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="8dp"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="筛选"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="12dp" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_asset_category_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="8dp" />
            </LinearLayout>
        </HorizontalScrollView>
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Tally.Button.Text"
            android:id="@+id/btn_assets_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:text="@string/assets_empty"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_assets_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:paddingBottom="80dp"
            app:cornerRadius="12dp"
            android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/fab_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:layout_margin="20dp"
        android:gravity="center_horizontal">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_transfer_asset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_transfer_arrows"
            android:contentDescription="转移资产"
            app:backgroundTint="@color/transfer_fab_bg"
            app:tint="@color/app_blue"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:borderWidth="0dp"
            app:rippleColor="@android:color/transparent"
            android:stateListAnimator="@null"
            app:fabCustomSize="48dp" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_asset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/text_on_accent"
            android:contentDescription="添加资产"
            app:backgroundTint="@color/app_blue"
            app:elevation="0dp"
            app:pressedTranslationZ="0dp"
            app:borderWidth="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

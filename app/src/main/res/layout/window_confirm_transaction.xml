<?xml version='1.0' encoding='utf-8'?>
<com.example.budgetapp.ui.ConfirmationOverlay
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/window_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:focusableInTouchMode="true">
    <androidx.cardview.widget.CardView
        android:id="@+id/window_card_content"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/app_background">
        <com.example.budgetapp.ui.LedgerEntryLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/window_confirmation_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="false"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">
                        <ImageView
                            android:id="@+id/iv_window_exclude_budget"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:padding="4dp"
                            android:src="@drawable/ic_dot_outline"
                            android:visibility="gone" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:text="记一笔"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="?android:attr/textColorPrimary" />
                    </RelativeLayout>
                    <com.example.budgetapp.ui.LedgerCategoryGrid
                        android:id="@+id/rv_window_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:overScrollMode="never" />
                    <TextView
                        android:id="@+id/tv_window_category_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondary"
                        android:visibility="gone" />
                    <RadioGroup
                        android:id="@+id/rg_window_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:id="@+id/rb_window_expense"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="支出"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_type_selector"
                            android:textColor="@color/text_type_selector"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />
                        <RadioButton
                            android:id="@+id/rb_window_income"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="收入"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_type_selector"
                            android:textColor="@color/text_type_selector"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />
                        <RadioButton
                            android:id="@+id/rb_window_liability"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="负债"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_type_selector"
                            android:textColor="@color/text_type_selector"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp" />
                        <RadioButton
                            android:id="@+id/rb_window_loan"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="借出"
                            android:gravity="center"
                            android:button="@null"
                            android:background="@drawable/bg_type_selector"
                            android:textColor="@color/text_type_selector"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp" />
                    </RadioGroup>
                    <Spinner
                        android:id="@+id/sp_asset"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:spinnerMode="dropdown"
                        android:dropDownHeight="160dp"
                        android:background="@drawable/bg_input_field"
                        android:popupBackground="@drawable/bg_input_field"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="0dp"
                        android:layout_marginBottom="16dp" />
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_window_target"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="输入负债/借出对象*"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textSize="16sp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="@dimen/confirmation_field_inset"
                        android:paddingVertical="10dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_window_amount"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:hint="金额"
                            android:inputType="numberDecimal"
                            android:textSize="16sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textColorHint="?android:attr/textColorHint"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="@dimen/confirmation_field_inset"
                            android:paddingVertical="10dp" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Tally.Button.Secondary"
                            android:id="@+id/btn_window_currency"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:text="¥"
                            android:textSize="18sp"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone"
                            app:rippleColor="@android:color/transparent" />
                    </LinearLayout>
                    <com.example.budgetapp.ui.CustomHighlightEditText
                        android:id="@+id/et_window_category"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="自定义分类*"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textColorHint="?android:attr/textColorHint"
                        android:textSize="16sp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="@dimen/confirmation_field_inset"
                        android:paddingVertical="10dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <com.example.budgetapp.ui.CustomHighlightEditText
                            android:id="@+id/et_window_remark"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="56dp"
                            android:hint="备注"
                            android:inputType="textCapSentences|textMultiLine"
                            android:imeOptions="flagNoExtractUi"
                            android:textSize="16sp"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textColorHint="?android:attr/textColorHint"
                            android:background="@drawable/bg_input_field"
                            android:paddingHorizontal="@dimen/confirmation_field_inset"
                            android:paddingVertical="10dp" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Tally.Button.Secondary"
                            android:id="@+id/btn_window_take_photo"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            app:icon="@drawable/ic_camera"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/text_primary"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone"
                            app:rippleColor="@android:color/transparent" />
                        <com.google.android.material.button.MaterialButton
                            style="@style/Widget.Tally.Button.Secondary"
                            android:id="@+id/btn_window_view_photo"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            app:icon="@drawable/ic_image"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/text_primary"
                            android:padding="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:visibility="gone"
                            app:rippleColor="@android:color/transparent" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Tally.Button.Secondary"
                    android:id="@+id/btn_window_cancel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="取消"
                    android:layout_marginEnd="8dp"
                    app:pressedTranslationZ="0dp" />
                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.Tally.Button"
                    android:id="@+id/btn_window_save"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="56dp"
                    android:text="确认保存"
                    app:pressedTranslationZ="0dp" />
            </LinearLayout>
        </com.example.budgetapp.ui.LedgerEntryLayout>
    </androidx.cardview.widget.CardView>
</com.example.budgetapp.ui.ConfirmationOverlay>

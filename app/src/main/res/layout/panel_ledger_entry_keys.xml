<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/bg_ledger_keypad" android:paddingHorizontal="10dp" android:paddingTop="3dp" android:paddingBottom="8dp">
    <LinearLayout android:id="@+id/entry_numeric_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button android:id="@+id/entry_key_7" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="7" />
            <Button android:id="@+id/entry_key_8" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="8" />
            <Button android:id="@+id/entry_key_9" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="9" />
            <ImageButton android:id="@+id/entry_key_delete" android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height"
                android:layout_weight="1" android:src="@drawable/ic_ledger_backspace" android:tint="@color/ledger_text"
                android:contentDescription="退格" android:background="?attr/selectableItemBackground" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button android:id="@+id/entry_key_4" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="4" />
            <Button android:id="@+id/entry_key_5" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="5" />
            <Button android:id="@+id/entry_key_6" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="6" />
            <Button android:id="@+id/entry_key_minus" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="−" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
            <Button android:id="@+id/entry_key_1" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="1" />
            <Button android:id="@+id/entry_key_2" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="2" />
            <Button android:id="@+id/entry_key_3" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="3" />
            <Button android:id="@+id/entry_key_plus" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="+" />
            </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
            <Button android:id="@+id/entry_save_again" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1"
                android:text="再记一笔" android:textColor="@color/ledger_chart_blue" android:textSize="13sp" />
            <Button android:id="@+id/entry_key_0" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="0" />
            <Button android:id="@+id/entry_key_decimal" style="@style/Widget.Tally.LedgerKey"
                android:layout_width="0dp" android:layout_height="@dimen/ledger_key_height" android:layout_weight="1" android:text="." />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Tally.Button" android:id="@+id/btn_save"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="@dimen/ledger_key_height"
                android:paddingStart="8dp" android:paddingEnd="8dp"
                android:paddingTop="0dp" android:paddingBottom="0dp"
                android:singleLine="true" android:text="@string/record_save" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="16dp" android:focusableInTouchMode="true"
    android:background="@drawable/bg_ledger_entry">

    <TextView android:id="@+id/tv_dialog_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="4dp" android:layout_marginBottom="12dp"
        android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ledger_text" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" android:background="@drawable/bg_ledger_control">
        <ImageView android:id="@+id/category_icon_preview" android:layout_width="26dp" android:layout_height="26dp"
            android:layout_gravity="start|center_vertical" android:layout_marginStart="12dp" android:importantForAccessibility="no" />
        <com.example.budgetapp.ui.CustomHighlightEditText
            android:id="@+id/et_category_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:background="@null" android:gravity="center_vertical"
            android:paddingStart="48dp" android:paddingEnd="12dp" android:hint="分类名称"
            android:singleLine="true" android:inputType="text" android:imeOptions="actionDone"
            android:textSize="16sp" android:textColor="@color/ledger_text" android:textColorHint="@color/ledger_muted" />
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/category_icon_grid"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1"
        android:scrollbars="vertical" android:fadeScrollbars="true" android:overScrollMode="never" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Tally.Button.Secondary" android:id="@+id/category_editor_secondary"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:text="取消" app:rippleColor="@android:color/transparent" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Tally.Button" android:id="@+id/btn_confirm"
            android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
            android:text="保存"
            app:rippleColor="@android:color/transparent" />
    </LinearLayout>
</LinearLayout>

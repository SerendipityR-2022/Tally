<?xml version="1.0" encoding="utf-8"?>
<com.example.budgetapp.ui.LedgerEntryLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:clipToOutline="true" android:background="@drawable/bg_ledger_entry" android:focusableInTouchMode="true">
    <androidx.core.widget.NestedScrollView android:id="@+id/record_form_scroll" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_weight="1" android:fillViewport="false" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
                android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="6dp" android:paddingTop="4dp">
                <TextView android:id="@+id/tv_dialog_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="记一笔" android:textColor="@color/ledger_text" android:textSize="21sp" android:fontFamily="sans-serif-medium" />
                <ImageView android:id="@+id/iv_exclude_budget" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="13dp" android:contentDescription="不计入预算" android:visibility="gone" />
                <TextView android:id="@+id/tv_revoke" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:gravity="center" android:paddingHorizontal="8dp" android:text="撤回"
                    android:textSize="14sp" android:textColor="@color/ledger_income" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete" style="@style/Widget.Tally.LedgerKey"
                    android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone"
                    android:contentDescription="删除账单" app:icon="@drawable/ic_delete_red" app:iconGravity="textStart" app:iconPadding="0dp"
                    app:iconTint="@color/ledger_income" />
                <ImageButton android:id="@+id/entry_close" android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="12dp" android:src="@drawable/ic_close" android:tint="@color/ledger_text"
                    android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="关闭记账" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="3dp" android:paddingBottom="5dp">
                <LinearLayout android:id="@+id/entry_top_fields" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioGroup android:id="@+id/rg_type" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:checkedButton="@id/rb_expense" android:layout_marginBottom="10dp">
                        <RadioButton android:id="@+id/rb_expense" style="@style/Widget.Tally.LedgerType"
                            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="支出"
                            android:layout_marginStart="0dp" />
                        <RadioButton android:id="@+id/rb_income" style="@style/Widget.Tally.LedgerType"
                            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="收入"
                            android:layout_marginStart="6dp" />
                        <RadioButton android:id="@+id/rb_liability" style="@style/Widget.Tally.LedgerType"
                            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="负债"
                            android:layout_marginStart="6dp" />
                        <RadioButton android:id="@+id/rb_lend" style="@style/Widget.Tally.LedgerType"
                            android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="借出"
                            android:layout_marginStart="6dp" />
                    </RadioGroup>
                    <LinearLayout android:id="@+id/entry_date_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/tv_dialog_date" style="@style/Widget.Tally.LedgerDate"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:drawableStart="@drawable/ic_ledger_calendar" android:layout_marginEnd="8dp" />
                        <TextView android:id="@+id/entry_time" style="@style/Widget.Tally.LedgerDate"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:drawableStart="@drawable/ic_ledger_clock" />
                    </LinearLayout>
                    <TextView android:id="@+id/entry_expression" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="7dp" android:textColor="@color/ledger_muted" android:gravity="end"
                        android:textSize="13sp" android:visibility="gone" />
                    <LinearLayout android:id="@+id/entry_amount_controls"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="5dp">
                        <TextView android:id="@+id/entry_currency_fallback" android:layout_width="48dp" android:layout_height="48dp"
                            android:gravity="center" android:text="¥" android:textColor="@color/ledger_muted" android:textSize="23sp"
                            android:importantForAccessibility="no" android:visibility="gone" />
                        <Button android:id="@+id/btn_currency" style="@style/Widget.Tally.LedgerKey"
                            android:layout_width="48dp" android:layout_height="48dp" android:text="¥" android:contentDescription="币种" />
                        <EditText android:id="@+id/et_amount" android:layout_width="0dp" android:layout_height="wrap_content"
                            android:minHeight="58dp" android:layout_weight="1" android:gravity="end|center_vertical" android:maxLines="1"
                            android:inputType="numberDecimal" android:background="@null" android:hint="0.00"
                            android:contentDescription="金额" android:textSize="34sp" android:fontFamily="sans-serif-medium"
                            android:fontFeatureSettings="tnum" android:textColor="@color/ledger_text" android:textColorHint="@color/ledger_muted" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ledger_rule" />
                </LinearLayout>
                <FrameLayout android:id="@+id/entry_asset_field" android:layout_width="match_parent" android:layout_height="48dp"
                    android:layout_marginTop="8dp" android:background="@drawable/bg_ledger_control">
                    <Spinner android:id="@+id/sp_asset" android:layout_width="match_parent" android:layout_height="match_parent"
                        android:paddingStart="34dp" android:paddingEnd="34dp" android:background="@android:color/transparent"
                        android:contentDescription="关联账户" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="10dp" android:src="@drawable/ic_ledger_wallet" android:tint="@color/ledger_muted"
                        android:importantForAccessibility="no" />
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="10dp" android:src="@drawable/ic_arrow_drop_down" android:tint="@color/ledger_muted"
                        android:importantForAccessibility="no" />
                </FrameLayout>
                <com.example.budgetapp.ui.LedgerCategoryGrid android:id="@+id/rv_category" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="5dp" android:scrollbars="vertical" android:nestedScrollingEnabled="true" />
                <EditText android:id="@+id/et_target_object" style="@style/Widget.Tally.LedgerField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="负债 / 借出对象" android:inputType="text" android:imeOptions="actionDone|flagNoExtractUi" android:visibility="gone" />
                <EditText android:id="@+id/et_custom_category" style="@style/Widget.Tally.LedgerField" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="自定义分类" android:inputType="text" android:imeOptions="actionDone|flagNoExtractUi" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingHorizontal="14dp" android:paddingTop="5dp" android:paddingBottom="7dp">
                <EditText android:id="@+id/et_remark" style="@style/Widget.Tally.LedgerField" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:hint="备注" android:inputType="textCapSentences" android:imeOptions="actionDone|flagNoExtractUi" android:maxLines="1" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_take_photo" style="@style/Widget.Tally.LedgerKey"
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp"
                    android:contentDescription="添加照片" app:icon="@drawable/ic_camera" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="22dp"
                    app:iconTint="@color/ledger_text" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_view_photo" style="@style/Widget.Tally.LedgerKey"
                    android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="4dp" android:visibility="gone"
                    android:contentDescription="查看照片" app:icon="@drawable/ic_image" app:iconGravity="textStart" app:iconPadding="0dp" app:iconSize="22dp"
                    app:iconTint="@color/ledger_chart_blue" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include layout="@layout/panel_ledger_entry_keys" />
</com.example.budgetapp.ui.LedgerEntryLayout>

<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ledger_canvas">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">
        <TextView
            android:id="@+id/tv_top_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="start|center_vertical"
            android:text="统计"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium" />
        <com.example.budgetapp.ui.PageSettingsButton
            android:id="@+id/btn_page_settings"
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/scroll_view_stats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <RadioGroup
                android:id="@+id/rg_time_scope"
                android:checkedButton="@id/rb_month"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_ledger_panel"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:padding="4dp">
                <RadioButton
                    android:id="@+id/rb_year"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="年"
                    android:gravity="center"
                    android:button="@null"
                    android:textColor="@color/selector_text_color"
                    android:background="@drawable/selector_tab_bg" />
                <RadioButton
                    android:id="@+id/rb_month"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="月"
                    android:gravity="center"
                    android:button="@null"
                    android:textColor="@color/selector_text_color"
                    android:background="@drawable/selector_tab_bg" />
                <RadioButton
                    android:id="@+id/rb_week"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="周"
                    android:gravity="center"
                    android:button="@null"
                    android:textColor="@color/selector_text_color"
                    android:background="@drawable/selector_tab_bg"
                     />
            </RadioGroup>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_left"
                    android:background="@null"
                    app:tint="@color/text_primary"
                    android:contentDescription="前一页" />
                <TextView
                    android:id="@+id/tv_current_date_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingHorizontal="4dp" />
                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_arrow_right"
                    android:background="@null"
                    app:tint="@color/text_primary"
                    android:contentDescription="后一页" />
            </LinearLayout>
            <LinearLayout android:id="@+id/ledger_stats_metrics" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:orientation="vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="12dp" android:background="@drawable/bg_ledger_panel">
                <LinearLayout style="@style/TallySummaryMetrics">
                    <LinearLayout style="@style/TallyStatsMetric">
                        <TextView android:id="@+id/ledger_metric_expense_label" style="@style/TallyStatsMetricLabel"
                            android:drawableStart="@drawable/ic_ledger_wallet" android:text="本月支出" />
                        <TextView android:id="@+id/ledger_metric_expense" style="@style/TallyStatsMetricValue" android:text="0.00" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/ledger_rule" />
                    <LinearLayout style="@style/TallyStatsMetric">
                        <TextView android:id="@+id/ledger_metric_daily_label" style="@style/TallyStatsMetricLabel"
                            android:drawableStart="@drawable/ic_ledger_calendar" android:text="日均支出" />
                        <TextView android:id="@+id/ledger_metric_daily" style="@style/TallyStatsMetricValue" android:text="0.00" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ledger_rule" />
                <LinearLayout style="@style/TallySummaryMetrics">
                    <LinearLayout style="@style/TallyStatsMetric">
                        <TextView android:id="@+id/ledger_metric_comparison_label" style="@style/TallyStatsMetricLabel"
                            android:drawableStart="@drawable/ic_ledger_trend" android:text="较上月" />
                        <TextView android:id="@+id/ledger_metric_comparison" style="@style/TallyStatsMetricValue" android:text="0.00" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/ledger_rule" />
                    <LinearLayout style="@style/TallyStatsMetric">
                        <TextView android:id="@+id/ledger_metric_balance_label" style="@style/TallyStatsMetricLabel"
                            android:drawableStart="@drawable/ic_ledger_bars" android:text="收支结余" />
                        <TextView android:id="@+id/ledger_metric_balance" style="@style/TallyStatsMetricValue" android:text="0.00" />
                    </LinearLayout>
                </LinearLayout>
                <View android:id="@+id/divider_overtime" android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="12dp" android:background="@color/ledger_rule" android:visibility="gone" />
                <TextView android:id="@+id/tv_overtime_content" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:textSize="13sp" android:textColor="@color/ledger_muted" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layout_trend_section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_ledger_panel">
                <TextView android:id="@+id/ledger_trend_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_ledger_trend" android:drawableTint="@color/ledger_chart_blue"
                    android:drawablePadding="8dp" android:gravity="center_vertical" android:text="支出趋势"
                    android:textColor="@color/ledger_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <RadioGroup android:id="@+id/ledger_trend_toggle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal" android:checkedButton="@id/ledger_trend_expense">
                    <RadioButton android:id="@+id/ledger_trend_expense" style="@style/Widget.Tally.LedgerType"
                        android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:text="支出" />
                    <RadioButton android:id="@+id/ledger_trend_income" style="@style/Widget.Tally.LedgerType"
                        android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                        android:layout_marginEnd="6dp" android:text="收入" />
                    <RadioButton android:id="@+id/ledger_trend_net" style="@style/Widget.Tally.LedgerType"
                        android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                        android:layout_marginEnd="0dp" android:text="结余" />
                </RadioGroup>
                <com.github.mikephil.charting.charts.LineChart android:id="@+id/chart_line"
                    android:layout_width="match_parent" android:layout_height="192dp" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/layout_expense_section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_ledger_panel">
                <TextView android:id="@+id/ledger_expense_composition_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_ledger_donut" android:drawableTint="@color/ledger_chart_blue"
                    android:drawablePadding="8dp" android:gravity="center_vertical" android:text="支出构成"
                    android:textColor="@color/ledger_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <com.example.budgetapp.ui.LedgerCompositionChart android:id="@+id/chart_pie"
                    android:layout_width="match_parent" android:layout_height="@dimen/ledger_composition_chart_height" android:layout_marginTop="8dp" />
                <LinearLayout android:id="@+id/ledger_expense_categories" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:id="@+id/ledger_income_section" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_ledger_panel">
                <TextView android:id="@+id/ledger_income_composition_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_ledger_donut" android:drawableTint="@color/ledger_chart_blue"
                    android:drawablePadding="8dp" android:gravity="center_vertical" android:text="收入构成"
                    android:textColor="@color/ledger_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <com.example.budgetapp.ui.LedgerCompositionChart android:id="@+id/chart_pie_income"
                    android:layout_width="match_parent" android:layout_height="@dimen/ledger_composition_chart_height" android:layout_marginTop="8dp" />
                <LinearLayout android:id="@+id/ledger_income_categories" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:id="@+id/ledger_month_compare" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_ledger_panel">
                <TextView android:id="@+id/ledger_month_compare_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_ledger_bars" android:drawableTint="@color/ledger_chart_blue"
                    android:drawablePadding="8dp" android:gravity="center_vertical" android:text="月支出对比"
                    android:textColor="@color/ledger_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <com.github.mikephil.charting.charts.BarChart android:id="@+id/ledger_month_chart"
                    android:layout_width="match_parent" android:layout_height="165dp" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/ledger_ranking" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:orientation="vertical"
                android:padding="16dp" android:background="@drawable/bg_ledger_panel">
                <TextView android:id="@+id/ledger_ranking_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_ledger_rank" android:drawableTint="@color/ledger_chart_blue"
                    android:drawablePadding="8dp" android:gravity="center_vertical" android:text="支出排行"
                    android:textColor="@color/ledger_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <LinearLayout android:id="@+id/ledger_ranked_transactions" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
                <Button android:id="@+id/ledger_ranking_all" style="@style/Widget.Tally.LedgerKey" android:layout_width="match_parent"
                    android:layout_height="48dp" android:text="查看全部" android:textSize="13sp"
                    android:drawableEnd="@drawable/ic_arrow_right" android:drawableTint="@color/ledger_chart_blue"
                    android:textColor="@color/ledger_chart_blue" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/tv_empty_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp" android:layout_marginBottom="14dp" android:gravity="center"
                android:drawableTop="@drawable/ic_ledger_bars" android:drawablePadding="9dp" android:drawableTint="@color/ledger_muted"
                android:padding="21dp" android:text="@string/stats_empty" android:textSize="14sp" android:textColor="@color/ledger_muted" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

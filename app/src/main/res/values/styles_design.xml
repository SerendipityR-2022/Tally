<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Tally.Button.Base" parent="Widget.Material3.Button">
        <item name="rippleColor">@android:color/transparent</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.Tally.Button" parent="Widget.Tally.Button.Base">
        <item name="backgroundTint">@color/tally_button_primary_fill</item>
        <item name="android:textColor">@color/tally_button_primary_text</item>
        <item name="iconTint">@color/tally_button_primary_text</item>
    </style>
    <style name="Widget.Tally.Button.Secondary" parent="Widget.Tally.Button.Base">
        <item name="backgroundTint">@color/tally_button_secondary_fill</item>
        <item name="android:textColor">@color/tally_button_secondary_text</item>
        <item name="iconTint">@color/tally_button_secondary_text</item>
    </style>
    <style name="Widget.Tally.Button.Danger" parent="Widget.Tally.Button.Base">
        <item name="backgroundTint">@color/tally_button_secondary_fill</item>
        <item name="android:textColor">@color/tally_button_danger_text</item>
        <item name="iconTint">@color/tally_button_danger_text</item>
    </style>
    <style name="Widget.Tally.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="rippleColor">@android:color/transparent</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/tally_button_text_action</item>
        <item name="iconTint">@color/tally_button_text_action</item>
    </style>
    <style name="Widget.Tally.QuickRecord" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="rippleColor">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Tally.QuickRecord</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="backgroundTint">@color/app_blue</item>
        <item name="tint">@color/text_on_accent</item>
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="ShapeAppearance.Tally.QuickRecord" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.Tally.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">12dp</item><item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item><item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Tally.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">10dp</item><item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item><item name="boxCornerRadiusBottomEnd">10dp</item>
    </style>
    <style name="TextAppearance.Tally.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item><item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Tally.Nav" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TallyNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/accent_soft</item><item name="android:height">32dp</item><item name="android:width">56dp</item>
    </style>
    <style name="TallySection">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item><item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item><item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item><item name="android:paddingStart">16dp</item>
    </style>
    <style name="Widget.Tally.LedgerType" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:background">@drawable/selector_ledger_type</item>
        <item name="android:button">@null</item>
        <item name="buttonCompat">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ledger_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Tally.LedgerKey" parent="Widget.Material3.Button.TextButton">
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/ledger_text</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Widget.Tally.FormInput" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:paddingStart">@dimen/tally_form_text_inset</item>
        <item name="android:paddingEnd">@dimen/tally_form_text_inset</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="Widget.Tally.FormSpinner" parent="Widget.AppCompat.Spinner">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_tally_form_spinner</item>
        <item name="android:paddingStart">@dimen/tally_form_text_inset</item>
        <item name="android:paddingEnd">44dp</item>
        <item name="android:popupBackground">@drawable/bg_input_field</item>
        <item name="android:popupElevation">4dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>
    <style name="Widget.Tally.PickerUnit" parent="Widget.AppCompat.TextView">
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:textColor">@color/ledger_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.Tally.LedgerField" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_ledger_control</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">7dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ledger_text</item>
        <item name="android:textColorHint">@color/ledger_muted</item>
    </style>
    <style name="Widget.Tally.LedgerDate" parent="Widget.AppCompat.TextView">
        <item name="android:minHeight">46dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_ledger_pill</item>
        <item name="android:foreground">@null</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@color/ledger_muted</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ledger_text</item>
    </style>
</resources>
